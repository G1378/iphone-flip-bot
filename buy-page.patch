+# --- Vinted (buy-page source) ------------------------------------------------------
+# Vinted has no public API: this is a scraper, it is against Vinted's terms of use, and Vinted
+# can block it at any time. It only ever reads public listings while logged OUT (never put
+# your own Vinted account anywhere near this). Leave VINTED_ENABLED=false to run eBay only.
+VINTED_ENABLED=false
+VINTED_DOMAIN=www.vinted.co.uk
+# A UK residential/mobile proxy (datacentre IPs are flagged almost at once). Several can be
+# given, comma separated; the scraper sticks to one and rotates when it gets blocked.
+# Format: http://username:password@host:port   (never commit this file)
+VINTED_PROXY_URLS=
+# Refuse to scrape from this machine's own IP when no proxy is set (recommended).
+VINTED_REQUIRE_PROXY=true
+# Optional: restrict to Vinted category ids (comma separated). Blank = keyword search only.
+VINTED_CATALOG_IDS=
+# Minutes between Vinted scans (0 = off). Gentler is safer: 15-30 is plenty for a flipper.
+VINTED_SCAN_INTERVAL_MINUTES=15
+VINTED_MIN_REQUEST_INTERVAL_SECONDS=6
+VINTED_RESULTS_PER_QUERY=40
+VINTED_MAX_DETAIL_LOOKUPS_PER_SCAN=15
+
 # --- Google Sheets ---------------------------------------------------------------
