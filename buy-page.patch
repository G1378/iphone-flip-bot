+# ================================================================== Vinted
+@pytest.mark.asyncio
+async def test_vinted_buyer_protection_is_part_of_what_you_pay(session, actor_id):
+    await _watch(session, actor_id)
+    _, res = await _scan_vinted(session, vitem(price="190", desc="Great phone"))
