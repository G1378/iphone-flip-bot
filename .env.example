# =============================================================================
# iPhone Flipping Business Manager — environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Business settings (currency, thresholds, fee assumptions, etc.) are NOT
# here — those are configured entirely from Discord via /config.
# =============================================================================

# --- Discord -----------------------------------------------------------------
# Create an application + bot at https://discord.com/developers/applications
# Enable "applications.commands" scope when inviting the bot to your server.
DISCORD_BOT_TOKEN=

# Optional: set this to your Discord server (guild) ID during development
# so slash commands sync instantly (global sync can take up to an hour).
# Right-click your server icon with Developer Mode on -> Copy Server ID.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to use the bot BEFORE any admin
# has been configured via /config users. Used only to bootstrap the first
# admin — after that, manage authorized users from /config users in Discord.
DISCORD_BOOTSTRAP_ADMIN_IDS=

# --- Database ------------------------------------------------------------------
# These are overridden by docker-compose.yml when running via Docker Compose
# (it points them at the `db` service using POSTGRES_* below). Only edit
# these directly if you're running the bot outside Docker.
DATABASE_URL=postgresql+asyncpg://iphoneflip:changeme@localhost:5432/iphoneflip
DATABASE_URL_SYNC=postgresql+psycopg2://iphoneflip:changeme@localhost:5432/iphoneflip

# Used by docker-compose.yml to configure the Postgres container.
POSTGRES_USER=iphoneflip
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iphoneflip

# Backups written here on the host (see section 10 / scripts/backup.sh).
# Fine to leave on the microSD card for a small operation; point it at
# external/USB storage if you have some and want extra peace of mind.
BACKUP_DIR=./backups

# --- eBay ----------------------------------------------------------------------
# Create an app at https://developer.ebay.com/my/keys
# Leave these blank to run with eBay integration disabled (the app runs
# normally; /list and eBay sync will report "not configured").
# Note: EBAY_CLIENT_ID + EBAY_CLIENT_SECRET alone are enough for /pricing
# (eBay's Buy APIs use app-level credentials, no user OAuth needed) - only
# listings/orders (the Sell APIs) need the refresh token below too.
EBAY_ENV=SANDBOX
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
# Obtain this by running: python scripts/ebay_oauth_setup.py (one-time, see README)
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_GB

# --- Google Sheets ---------------------------------------------------------------
# Create a service account + JSON key in Google Cloud Console, share your
# target spreadsheet with the service account's email address (Editor
# access), and mount/copy the JSON key to the path below.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google_service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
# Host-machine path to the downloaded service account JSON, mounted
# read-only into the bot container by docker-compose.yml.
GOOGLE_SERVICE_ACCOUNT_HOST_PATH=./secrets/google_service_account.json

# --- App behaviour ----------------------------------------------------------------
LOG_LEVEL=INFO
# development | production — /demo refuses to run when this is "production".
ENVIRONMENT=development
TIMEZONE=Europe/London
EBAY_SYNC_INTERVAL_MINUTES=15
SHEETS_SYNC_INTERVAL_MINUTES=10
# How often /pricing watchlist entries auto-refresh from eBay (days)
PRICING_SYNC_INTERVAL_DAYS=7
